# Lavish Luster server configuration
PORT=3001
# Set when running behind a reverse proxy / load balancer (e.g. "1" or "loopback")
TRUST_PROXY=
# 301 redirects from old WordPress URLs (/shop, /product/*, /about-us, /contacts) — pending approval
REDIRECTS_ENABLED=false

# Contact form — keep false until the Privacy Policy and consent wording are published
# (also enable features.inquirySubmission and set integrations.inquiry.consentText in the client).
INQUIRY_ENABLED=false
INQUIRY_CONSENT_REQUIRED=true
INQUIRY_TO=info@lavishluster.com
INQUIRY_FROM=
INQUIRY_RATE_WINDOW_MS=900000
INQUIRY_RATE_MAX=5

# SMTP delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
